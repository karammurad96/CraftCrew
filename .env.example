# Copy this file to .env on the server and replace every value before starting production.
# Public domain name. Its DNS A/AAAA record must point to the server; Caddy obtains the HTTPS certificate automatically.
DOMAIN=craftcrew.example.com
# Email address for Let's Encrypt certificate notices.
ACME_EMAIL=it@your-company.example
# First administrator, created once when the production data store is initialised.
BOOTSTRAP_ADMIN_EMAIL=admin@your-company.example
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-secret-of-at-least-16-characters

# Outgoing email (SMTP). Port 465 = TLS, 587 = STARTTLS. Example for Brevo: smtp-relay.brevo.com, 587.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
SMTP_FROM=CraftCrew <no-reply@your-domain.example>
# Optional: public URL used in email links (defaults to https://DOMAIN).
# APP_URL=https://craftcrew.example.com
